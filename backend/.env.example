# SQLite file used by SQLAlchemy
DATABASE_URL=sqlite:///./zoom_clone.db
# Frontend origin: used to build invite links and for CORS
FRONTEND_URL=http://localhost:3000
# Optional TURN relay so audio/video also connect on mobile data / strict networks.
# Either Cloudflare Realtime TURN (dash.cloudflare.com -> Realtime -> TURN Server):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# ...or any TURN server with fixed credentials (comma-separated URLs):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
